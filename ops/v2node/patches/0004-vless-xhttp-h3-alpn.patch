+func validateH3Transport(nodeInfo *panel.NodeInfo) error {
+	if nodeInfo == nil || nodeInfo.Common == nil {
+		return nil
+	}
+	if nodeInfo.Type == "hysteria2" || nodeInfo.Type == "tuic" {
+		return nil
+	}
+
+	alpn := nodeInfo.Common.TlsSettings.ALPN
+	hasH3 := false
+	for _, protocol := range alpn {
+		if strings.EqualFold(strings.TrimSpace(protocol), "h3") {
+			hasH3 = true
+			break
+		}
+	}
+	if !hasH3 {
+		return nil
+	}
+	if len(alpn) != 1 || alpn[0] != "h3" {
+		return errors.New(`xhttp h3 requires tls_settings.alpn to be exactly ["h3"]`)
+	}
+	if nodeInfo.Security != panel.Tls {
+		return errors.New("xhttp h3 requires tls security; reality and security none are unsupported")
+	}
+	if nodeInfo.Common.Network != "xhttp" && nodeInfo.Common.Network != "splithttp" {
+		return fmt.Errorf("xhttp h3 requires xhttp network, got %q", nodeInfo.Common.Network)
+	}
+	if nodeInfo.Common.CertInfo == nil || nodeInfo.Common.CertInfo.CertMode == "" || nodeInfo.Common.CertInfo.CertMode == "none" {
+		return errors.New("xhttp h3 requires a configured tls certificate")
+	}
+	return nil
+}
+
 // BuildInbound build Inbound config for different protocol
 func buildInbound(nodeInfo *panel.NodeInfo, tag string) (*core.InboundHandlerConfig, error) {
+	if err := validateH3Transport(nodeInfo); err != nil {
+		return nil, err
+	}
 	in := &coreConf.InboundDetourConfig{}
 	var err error
 	switch nodeInfo.Type {
@@ -148,9 +185,13 @@ func buildInbound(nodeInfo *panel.NodeInfo, tag string) (*core.InboundHandlerCon

+// ACME requests inherit the renewal task deadline. Node payloads cannot install
+// process-wide DNS credentials. The central issuer uses a separate process.
+type certContextTransport struct{ ctx context.Context }
+
+func (t certContextTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	// Preserve the client's per-request deadline as well as task cancellation.
+	// Cancellation must live until the response body is consumed, not merely
+	// until response headers arrive.
+	ctx, cancel := context.WithCancel(r.Context())
+	parent := t.ctx
+	if parent == nil {
+		parent = context.Background()
+	}
+	stop := context.AfterFunc(parent, cancel)
+	var once sync.Once
+	finish := func() { once.Do(func() { stop(); cancel() }) }
+	response, err := http.DefaultTransport.RoundTrip(r.Clone(ctx))
+	if err != nil {
+		finish()
+		return nil, err
+	}
+	response.Body = &certContextBody{ReadCloser: response.Body, finish: finish}
+	return response, nil
+}
+
+type certContextBody struct {
+	io.ReadCloser
+	finish func()
+}
+
+func (b *certContextBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if err != nil {
+		b.finish()
+	}
+	return n, err
+}
+func (b *certContextBody) Close() error { err := b.ReadCloser.Close(); b.finish(); return err }

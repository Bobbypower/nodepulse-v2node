+)
+
+func TestACMETransportPreservesBodyAndRequestTimeout(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/complete" {
+			io.WriteString(w, "synthetic-complete-response")
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	client := &http.Client{Timeout: 200 * time.Millisecond, Transport: certContextTransport{ctx: context.Background()}}
+	response, err := client.Get(server.URL + "/complete")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(response.Body)
+	response.Body.Close()
+	if err != nil || string(body) != "synthetic-complete-response" {
+		t.Fatal("transport canceled body before it was consumed")
+	}
+	response, err = client.Get(server.URL + "/stall")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = io.ReadAll(response.Body)
+	response.Body.Close()
+	if err == nil {
+		t.Fatal("transport lost the HTTP client's response deadline")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	client = &http.Client{Timeout: 2 * time.Second, Transport: certContextTransport{ctx: ctx}}
+	response, err = client.Get(server.URL + "/stall")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	_, err = io.ReadAll(response.Body)
+	response.Body.Close()
+	if err == nil {
+		t.Fatal("transport ignored task cancellation")
+	}
+}
+
+func TestNativeHTTP01ProviderChallengeLifecycle(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := listener.Addr().String()
+	_, port, _ := net.SplitHostPort(address)
+	listener.Close()
+	provider := http01.NewProviderServer("127.0.0.1", port)
+	if err := provider.Present("node.example.invalid", "synthetic-token", "synthetic-key-authorization"); err != nil {
+		t.Fatal(err)
+	}
+	defer provider.CleanUp("node.example.invalid", "synthetic-token", "synthetic-key-authorization")
+	client := &http.Client{Timeout: 2 * time.Second}
+	request, err := http.NewRequest(http.MethodGet, "http://"+address+"/.well-known/acme-challenge/synthetic-token", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Host = "node.example.invalid"
+	response, err := client.Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	body, _ := io.ReadAll(response.Body)
+	if response.StatusCode != 200 || string(body) != "synthetic-key-authorization" {
+		t.Fatal("HTTP-01 challenge did not return expected authorization")
+	}
+}
+
+func lifecyclePair(t *testing.T, days int) ([]byte, []byte) {
+	t.Helper()
+	k, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	c := &x509.Certificate{SerialNumber: big.NewInt(int64(days + 100)), DNSNames: []string{"node.example.invalid"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Duration(days) * 24 * time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, c, c, k.Public(), k)
+	if err != nil {
+		t.Fatal(err)
+	}
+	key, _ := x509.MarshalECPrivateKey(k)
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: key})
+}
+
+func TestDNSPayloadCredentialsRejectedWithoutGlobalEnvironmentMutation(t *testing.T) {
+	name := "NODEPULSE_CERT_SYNTHETIC_MARKER"
+	before, exists := os.LookupEnv(name)
+	config := &panel.CertInfo{CertMode: "dns", DNSEnv: map[string]string{name: "synthetic-credential-marker"}}
+	if _, err := NewLego(config); err == nil || strings.Contains(err.Error(), "synthetic-credential-marker") {
+		t.Fatal("credential payload not safely rejected")
+	}
+	if err := (&Lego{config: config}).SetProvider(); err == nil {
+		t.Fatal("provider accepted payload credentials")
+	}
+	after, nowExists := os.LookupEnv(name)
+	if exists != nowExists || before != after {
+		t.Fatal("process environment mutated")
+	}
+}
+
+func TestACMEAccountSaveLoadAndExistingPermissions(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "user")
+	if err := filesystem.EnsurePrivateDirectory(dir); err != nil {
+		t.Fatal(err)
+	}
+	name := filepath.Join(dir, "account.json")
+	k, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	u := &User{Email: "synthetic@example.invalid", key: k}
+	if err := u.Save(name); err != nil {
+		t.Fatal(err)
+	}
+	info, _ := os.Stat(name)
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("account key not private")
+	}
+	os.Chmod(name, 0644)
+	loaded, err := NewLegoUser(name, u.Email)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.GetPrivateKey() == nil || loaded.KeyEncoded != "" {
+		t.Fatal("private account key retained in exported field")
+	}
+	info, _ = os.Stat(name)
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("existing account not restricted")
+	}
+	if err := (&User{}).Save(name); err == nil {
+		t.Fatal("invalid account overwrote file")
+	}
+	var read User
+	if err := read.Load(name); err != nil {
+		t.Fatal("old account destroyed")
+	}
+	if _, err := u.DecodePrivate("malformed"); err == nil {
+		t.Fatal("malformed account did not fail safely")
+	}
+}
+
+func TestRenewalWindowAndMalformedInput(t *testing.T) {
+	l := &Lego{}
+	for _, item := range []struct {
+		days int
+		due  bool
+	}{{90, false}, {31, false}, {30, true}, {10, true}, {-1, true}} {
+		cert, _ := lifecyclePair(t, item.days)
+		due, err := l.CheckCert(cert)
+		if err != nil || due != item.due {
+			t.Fatalf("window %d: %v %v", item.days, due, err)
+		}
+	}
+	if _, err := l.CheckCert([]byte("bad")); err == nil {
+		t.Fatal("malformed cert silently ignored")
+	}
+}
+
+func TestLegoWriteUsesAtomicPairAndCancellationGuard(t *testing.T) {
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert"), filepath.Join(dir, "key")
+	cert, key := lifecyclePair(t, 90)
+	l := &Lego{config: &panel.CertInfo{CertFile: cp, KeyFile: kp, CertDomain: "node.example.invalid"}}
+	if err := l.writeCert(&certificate.Resource{Certificate: cert, PrivateKey: key}); err != nil {
+		t.Fatal(err)
+	}
+	info, _ := os.Stat(kp)
+	if info.Mode().Perm() != 0600 {
+		t.Fatal("leaf key not private")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	l.ctx = ctx
+	if err := l.writeCert(&certificate.Resource{Certificate: cert, PrivateKey: key}); err != context.Canceled {
+		t.Fatal("cancelled issuance committed")
+	}
+}

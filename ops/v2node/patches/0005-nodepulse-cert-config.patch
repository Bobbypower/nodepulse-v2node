+func mergeCertConfig(tls *TlsSettings, cert TlsSettings) {
+	if tls == nil {
+		return
+	}
+	if cert.CertMode != "" {
+		tls.CertMode = cert.CertMode
+	}
+	if cert.CertFile != "" {
+		tls.CertFile = cert.CertFile
+	}
+	if cert.KeyFile != "" {
+		tls.KeyFile = cert.KeyFile
+	}
+	if cert.TlsCert != "" {
+		tls.TlsCert = cert.TlsCert
+	}
+	if cert.TlsKey != "" {
+		tls.TlsKey = cert.TlsKey
+	}
+	if cert.Provider != "" {
+		tls.Provider = cert.Provider
+	}
+	if cert.DNSEnv != "" {
+		tls.DNSEnv = cert.DNSEnv
+	}
+	if cert.RejectUnknownSni != "" {
+		tls.RejectUnknownSni = cert.RejectUnknownSni
+	}
+}

+package panel
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+func TestMergeTopLevelCertConfigIntoTLSSettings(t *testing.T) {
+	var node CommonNode
+	err := json.Unmarshal([]byte(`{
+		"tls_settings": {
+			"server_name": "jp4.eatp.top",
+			"server_names": ["jp4.eatp.top"],
+			"alpn": ["h3"]
+		},
+		"cert_config": {
+			"cert_mode": "http",
+			"cert_file": "/etc/v2node/vless66.cer",
+			"key_file": "/etc/v2node/vless66.key",
+			"reject_unknown_sni": "1"
+		}
+	}`), &node)
+	if err != nil {
+		t.Fatalf("decode node config: %v", err)
+	}
+
+	mergeCertConfig(&node.TlsSettings, node.CertConfig)
+
+	if node.TlsSettings.ServerName != "jp4.eatp.top" {
+		t.Fatalf("server name = %q", node.TlsSettings.ServerName)
+	}
+	if !reflect.DeepEqual(node.TlsSettings.ALPN, []string{"h3"}) {
+		t.Fatalf("ALPN = %#v", node.TlsSettings.ALPN)
+	}
+	if node.TlsSettings.CertMode != "http" {
+		t.Fatalf("cert mode = %q", node.TlsSettings.CertMode)
+	}
+	if node.TlsSettings.CertFile != "/etc/v2node/vless66.cer" {
+		t.Fatalf("cert file = %q", node.TlsSettings.CertFile)
+	}
+	if node.TlsSettings.KeyFile != "/etc/v2node/vless66.key" {
+		t.Fatalf("key file = %q", node.TlsSettings.KeyFile)
+	}
+	if node.TlsSettings.RejectUnknownSni != "1" {
+		t.Fatalf("reject unknown SNI = %q", node.TlsSettings.RejectUnknownSni)
+	}
+}

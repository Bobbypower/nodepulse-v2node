+		conn, err := net.DialTimeout("tcp", fmt.Sprintf("127.0.0.1:%d", port), time.Second)
+		if err != nil {
+			return nil, err
+		}
+		_ = conn.SetDeadline(time.Now().Add(2 * time.Second))
+		id, _ := hex.DecodeString("11111111111141118111111111111111")
+		hello := append([]byte{0}, id...)
+		hello = append(hello, 0, 1)
+		hello = binary.BigEndian.AppendUint16(hello, uint16(echo.Addr().(*net.TCPAddr).Port))
+		hello = append(hello, 1, 127, 0, 0, 1)
+		hello = append(hello, []byte("ping")...)
+		if _, err = conn.Write(hello); err != nil {
+			conn.Close()
+			return nil, err
+		}
+		var header [2]byte
+		if _, err = io.ReadFull(conn, header[:]); err != nil {
+			conn.Close()
+			return nil, err

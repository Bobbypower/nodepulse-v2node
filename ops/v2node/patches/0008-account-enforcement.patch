+func TestAccountRevokeCoversBothXHTTPInboundsAndRetryAfterRebuild(t *testing.T) {
+	first, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		first.Close()
+		t.Fatal(err)
+	}
+	primaryPort, downloadPort := first.Addr().(*net.TCPAddr).Port, second.Addr().(*net.TCPAddr).Port
+	first.Close()
+	second.Close()
+	info := &panel.NodeInfo{Type: "vless", Tag: "isolated-revoke", Common: &panel.CommonNode{
+		ListenIP: "127.0.0.1", ServerPort: primaryPort, Network: "xhttp", NetworkSettings: json.RawMessage(`{"path":"/isolated-revoke","mode":"auto"}`),
+		XHTTPDownloadInbound: &panel.XHTTPDownloadInbound{ListenIP: "127.0.0.1", ServerPort: downloadPort, Network: "xhttp"}}}
+	config := conf.New()
+	config.LogConfig.Level = "none"
+	server := New(config)
+	if err = server.Start([]*panel.NodeInfo{info}); err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	if err = server.AddNode(info.Tag, info); err != nil {
+		t.Fatal(err)
+	}
+	users := []panel.UserInfo{{Id: 101, Uuid: "11111111-1111-4111-8111-111111111111"}}
+	params := &AddUsersParams{Tag: info.Tag, NodeInfo: info, Users: users}
+	checkCount := func(expected int64) {
+		t.Helper()
+		for _, tag := range []string{info.Tag, XHTTPDownloadTag(info.Tag)} {
+			manager, err := server.GetUserManager(tag)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := manager.GetUsersCount(context.Background()); got != expected {
+				t.Fatalf("%s users=%d want %d", tag, got, expected)
+			}
+		}
+	}
+	if _, err = server.AddUsers(params); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = server.AddUsers(params); err != nil {
+		t.Fatal(err)
+	}
+	checkCount(1)
+	for range 2 {
+		if _, err = server.RevokeUserID(101, info.Tag, info); err != nil {
+			t.Fatal(err)
+		}
+	}
+	checkCount(0)
+	if _, err = server.AddUsers(params); err != nil {
+		t.Fatal(err)
+	}
+	checkCount(1)
+	// One listener disappears during cleanup: deny the other immediately, retain
+	// the failed operation, then finish idempotently after the listener returns.
+	if err = server.removeInbound(XHTTPDownloadTag(info.Tag)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = server.RevokeUserID(101, info.Tag, info); err == nil {
+		t.Fatal("missing listener reported success")
+	}
+	manager, _ := server.GetUserManager(info.Tag)
+	if manager.GetUsersCount(context.Background()) != 0 {
+		t.Fatal("primary credential survived partial failure")
+	}
+	download, _ := xhttpDownloadNodeInfo(info)
+	inbound, err := buildInbound(download, XHTTPDownloadTag(info.Tag))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = server.addInbound(inbound); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = server.RevokeUserID(101, info.Tag, info); err != nil {
+		t.Fatal("retry after rebuild", err)
+	}
+	checkCount(0)
+	if _, err = server.AddUsers(params); err != nil {
+		t.Fatal(err)
+	}
+	checkCount(1)
+}

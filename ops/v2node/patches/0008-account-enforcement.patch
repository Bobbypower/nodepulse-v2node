+	defer live.Close()
+	request("POST", "/api/v1/subcore/webhooks/audit", map[string]any{"events": []any{map[string]any{
+		"event_id": "isolated-enforcement-e2e-0001", "user_id": 101, "node_id": 1, "rule_id": 920002, "violation_type": "block", "occurred_at": time.Now().UTC().Format(time.RFC3339Nano)}}})

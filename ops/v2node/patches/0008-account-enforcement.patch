+++ b/api/v2board/account_enforcement.go
@@ -0,0 +1,104 @@
+package panel
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+)
+
+const EnforcementCapability = "nodepulse-enforcement/1"
+
+type AccountCommand struct {
+	UserID     int    `json:"user_id"`
+	Version    int64  `json:"version"`
+	Blocked    bool   `json:"blocked"`
+	DeliveryID string `json:"delivery_id"`
+}
+
+func redactPanelMessage(message, secret string) string {
+	if secret == "" {
+		return message
+	}
+	return strings.ReplaceAll(strings.ReplaceAll(message, secret, "[redacted]"), url.QueryEscape(secret), "[redacted]")
+}
+
+type panelLogger struct{ secret string }
+
+func (l panelLogger) Errorf(format string, args ...interface{}) {
+	log.Error(redactPanelMessage(fmt.Sprintf(format, args...), l.secret))
+}
+func (l panelLogger) Warnf(format string, args ...interface{}) {
+	log.Warn(redactPanelMessage(fmt.Sprintf(format, args...), l.secret))
+}
+func (l panelLogger) Debugf(format string, args ...interface{}) {
+	log.Debug(redactPanelMessage(fmt.Sprintf(format, args...), l.secret))
+}
+
+func (c *Client) AccountCommands(ctx context.Context, instance string) ([]AccountCommand, error) {
+	result := make([]AccountCommand, 0)
+	cursor := 0
+	for page := 0; page < 64; page++ {
+		var body struct {
+			Commands []struct {
+				UserID     int    `json:"user_id"`
+				Version    int64  `json:"version"`
+				Blocked    *bool  `json:"blocked"`
+				DeliveryID string `json:"delivery_id"`
+			} `json:"commands"`
+			Next int `json:"next_cursor"`
+		}
+		response, err := c.client.R().SetContext(ctx).SetQueryParam("runtime_instance", instance).
+			SetQueryParam("after", strconv.Itoa(cursor)).SetResult(&body).Get("/api/v2/server/account-enforcement")
+		if err != nil || response == nil {
+			return nil, errors.New("account enforcement request failed")
+		}
+		if response.StatusCode() == 404 {
+			return result, nil
+		}
+		if response.StatusCode() != 200 || body.Commands == nil {
+			return nil, errors.New("invalid account enforcement response")
+		}
+		for _, command := range body.Commands {
+			if command.UserID <= 0 || command.Version <= 0 || command.Blocked == nil || len(command.DeliveryID) != 36 {
+				return nil, errors.New("invalid account enforcement command")
+			}
+			result = append(result, AccountCommand{UserID: command.UserID, Version: command.Version, Blocked: *command.Blocked, DeliveryID: command.DeliveryID})
+		}
+		if body.Next == 0 {
+			return result, nil
+		}
+		if body.Next <= cursor {
+			return nil, errors.New("account enforcement cursor did not advance")
+		}
+		cursor = body.Next
+	}
+	return nil, errors.New("account enforcement page limit reached")
+}
+
+func (c *Client) AccountReceipt(ctx context.Context, instance string, command AccountCommand, applied bool) error {
+	outcome := "failed"
+	if applied {
+		outcome = "applied"
+	}
+	body := map[string]any{"user_id": command.UserID, "version": command.Version, "delivery_id": command.DeliveryID,
+		"runtime_instance": instance, "runtime_version": EnforcementCapability, "outcome": outcome,
+		"connections_cleared": applied && command.Blocked}
+	if !applied {
+		body["error_code"] = "apply_failed"
+		if command.Blocked {
+			body["error_code"] = "remove_failed"
+		}
+	}
+	response, err := c.client.R().SetContext(ctx).SetBody(body).Post("/api/v2/server/account-enforcement/ack")
+	if err != nil || response == nil || response.StatusCode() != 200 {
+		return errors.New("account enforcement receipt not accepted")
+	}
+	return nil
+}
+
+func (c *Client) ResetUserETag() { c.userEtag = "" }

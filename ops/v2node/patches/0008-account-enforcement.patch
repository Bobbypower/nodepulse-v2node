+	// treating HTTP delivery as proof that the connection was closed.
+	fault, faultError := http.Post(panelURL+"/test/fail-next-ack", "application/json", bytes.NewBufferString("{}"))
+	if faultError != nil {
+		t.Fatal(faultError)
+	}
+	fault.Body.Close()
+	if fault.StatusCode != 200 {
+		t.Fatal("local fault injection failed")
+	}
+	if err = c.pullAccountRestrictions(ctx); err == nil {
+		t.Fatal("lost execution receipt was incorrectly treated as confirmed")
+	}
+	users, err = api.GetUserList(ctx)
+	if err != nil || users == nil || len(users) != 0 {
+		t.Fatalf("ban payload must be explicit empty list: %v %v", users, err)
+	}
+	if err = c.applyAccountUsers(ctx, users); err != nil {
+		t.Fatal(err)
+	}
+	_ = live.SetReadDeadline(time.Now().Add(2 * time.Second))
+	var b [1]byte
+	_, err = live.Read(b[:])
+	if err == nil {
+		t.Fatal("existing connection survived ban")
+	}
+	if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+		t.Fatal("existing connection was not closed")
+	}
+	if conn, err := dial(); err == nil {
+		conn.Close()
+		t.Fatal("banned identity opened a new connection")
+	}
+	if err = c.pullAccountRestrictions(ctx); err != nil {
+		t.Fatal("receipt retry failed", err)
+	}
+	waitIntent(1, true)
+	records := request("GET", "/api/v1/admin/abuse-records?user_id=101", nil)
+	items, ok := records["items"].([]any)
+	if !ok || len(items) != 1 {
+		t.Fatalf("expected one synthetic audit record: %v", records)
+	}
+	id := items[0].(map[string]any)["id"].(float64)
+	request("POST", fmt.Sprintf("/api/v1/admin/abuse-records/%.0f/unban", id), nil)
+	waitIntent(2, false)
+	if err = c.pullAccountRestrictions(ctx); err != nil {
+		t.Fatal(err)
+	}
+	users, err = api.GetUserList(ctx)
+	if err != nil || len(users) != 1 {
+		t.Fatalf("released snapshot: %v %v", users, err)
+	}
+	if err = c.applyAccountUsers(ctx, users); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := dial()
+	if err != nil {
+		t.Fatalf("released identity failed to reconnect: %v", err)
+	}
+	restored.Close()
+	waitIntent(2, true)
+	t.Log("real Commerce audit -> NodePulse -> VLESS: live connection closed, new access denied, release reconnected")
+}
diff --git a/core/app/dispatcher/account_enforcement_test.go b/core/app/dispatcher/account_enforcement_test.go

+		t.Fatal(err)
+	}
+	defer server.Close()
+	if err = server.AddNode(info.Tag, info); err != nil {
+		t.Fatal(err)
+	}
+	api, err := panel.New(&conf.NodeConfig{APIHost: panelURL, NodeID: 1, Key: "local-enforcement-test", Timeout: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	users, err := api.GetUserList(ctx)
+	if err != nil || len(users) != 1 {

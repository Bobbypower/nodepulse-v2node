+
+// Explicit opt-in: the harness runs the real Commerce and NodePulse routes with
+// isolated SQLite databases, synthetic identities, and localhost listeners.
+func TestAccountEnforcementLocalServices(t *testing.T) {
+	commerceURL, panelURL := os.Getenv("NODE_ENFORCEMENT_COMMERCE_URL"), os.Getenv("NODE_ENFORCEMENT_NODEPULSE_URL")
+	if commerceURL == "" || panelURL == "" {
+		t.Skip("requires isolated local service harness")
+	}
+	for _, endpoint := range []string{commerceURL, panelURL} {
+		parsed, err := url.Parse(endpoint)
+		if err != nil || parsed.Hostname() != "127.0.0.1" {
+			t.Fatal("integration endpoints must be localhost")
+		}
+	}
+	request := func(method, path string, body any) map[string]any {
+		t.Helper()
+		data, _ := json.Marshal(body)
+		req, err := http.NewRequest(method, commerceURL+path, bytes.NewReader(data))
+		if err != nil {
+			t.Fatal(err)
+		}
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Authorization", "Bearer local-enforcement-test")
+		response, err := (&http.Client{Timeout: 3 * time.Second}).Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer response.Body.Close()
+		var value map[string]any
+		if err = json.NewDecoder(response.Body).Decode(&value); err != nil {
+			t.Fatal(err)
+		}
+		if response.StatusCode != 200 {
+			t.Fatalf("local route %s returned %d: %v", path, response.StatusCode, value)
+		}
+		return value
+	}
+	waitIntent := func(version float64, confirmed bool) {
+		t.Helper()
+		deadline := time.Now().Add(12 * time.Second)
+		for time.Now().Before(deadline) {
+			value := request("GET", "/api/v1/admin/abuse-records/users/101/enforcement", nil)
+			state, ok := value["execution"].(map[string]any)
+			if ok && state["revision"] == version && (state["status"] == "waiting_nodes" || state["status"] == "confirmed") && (!confirmed || state["status"] == "confirmed") {
+				return
+			}
+			time.Sleep(100 * time.Millisecond)
+		}
+		t.Fatal("local enforcement intent did not reach expected state")
+	}
+	echo, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echo.Close()
+	go func() {
+		for {
+			conn, err := echo.Accept()
+			if err != nil {
+				return
+			}
+			go func() { defer conn.Close(); _, _ = io.Copy(conn, conn) }()
+		}
+	}()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := listener.Addr().(*net.TCPAddr).Port
+	listener.Close()
+	info := &panel.NodeInfo{Id: 1, Type: "vless", Tag: "local-enforcement", Common: &panel.CommonNode{
+		Protocol: "vless", ListenIP: "127.0.0.1", ServerPort: port, Network: "tcp"}}
+	// Xray 26.9.30 blocks private destinations by default. Grant only the
+	// loopback echo endpoint in this isolated test; production keeps defaults.
+	localOutbound := fmt.Sprintf(`{"tag":"isolated-echo","protocol":"freedom","settings":{"finalRules":[{"action":"allow","ip":["127.0.0.1/32"],"port":"%d"}]}}`, echo.Addr().(*net.TCPAddr).Port)
+	info.Common.Routes = []panel.Route{{Id: 1, Action: "route_ip", Match: []string{"127.0.0.1/32"}, ActionValue: &localOutbound}}
+	config := conf.New()
+	config.LogConfig.Level = "none"
+	server := core.New(config)

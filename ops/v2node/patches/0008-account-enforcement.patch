new file mode 100644
--- /dev/null
+++ b/node/account_enforcement.go
@@ -0,0 +1,133 @@
+package node
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	panel "github.com/wyx2685/v2node/api/v2board"
+	vCore "github.com/wyx2685/v2node/core"
+)
+
+type accountRestrictions struct {
+	instance string
+	versions map[int]int64
+	blocked  map[int]bool
+	pending  map[int]panel.AccountCommand
+}
+
+func newAccountRestrictions() *accountRestrictions {
+	value := make([]byte, 16)
+	if _, err := rand.Read(value); err != nil {
+		panic("cannot initialize enforcement runtime identity")
+	}
+	return &accountRestrictions{instance: hex.EncodeToString(value), versions: make(map[int]int64),
+		blocked: make(map[int]bool), pending: make(map[int]panel.AccountCommand)}
+}
+
+func (c *Controller) pullAccountRestrictions(ctx context.Context) error {
+	if c.accounts == nil {
+		c.accounts = newAccountRestrictions()
+	}
+	commands, fetchError := c.apiClient.AccountCommands(ctx, c.accounts.instance)
+	if fetchError == nil {
+		for _, command := range commands {
+			if command.Version < c.accounts.versions[command.UserID] {
+				continue
+			}
+			c.accounts.versions[command.UserID] = command.Version
+			c.accounts.pending[command.UserID] = command
+			if command.Blocked {
+				c.accounts.blocked[command.UserID] = true
+			}
+		}
+	}
+	failures := []error{fetchError}
+	for uid, command := range c.accounts.pending {
+		if !command.Blocked {
+			c.apiClient.ResetUserETag()
+			continue
+		}
+		removed, err := c.server.RevokeUserID(uid, c.tag, c.info)
+		if err != nil {
+			_ = c.apiClient.AccountReceipt(ctx, c.accounts.instance, command, false)
+			failures = append(failures, err)
+			continue
+		}
+		c.updateAccountLimiter(nil, removed, nil)
+		filtered := make([]panel.UserInfo, 0, len(c.userList))
+		for _, user := range c.userList {
+			if user.Id != uid {
+				filtered = append(filtered, user)
+			}
+		}
+		c.userList = filtered
+		if err := c.apiClient.AccountReceipt(ctx, c.accounts.instance, command, true); err != nil {
+			failures = append(failures, err)
+		} else {
+			delete(c.accounts.pending, uid)
+		}
+	}
+	return errors.Join(failures...)
+}
+
+func (c *Controller) updateAccountLimiter(added, deleted, modified []panel.UserInfo) {
+	if c.limiter == nil {
+		return
+	}
+	c.limiter.UpdateUser(c.tag, added, deleted, modified)
+	if vCore.HasXHTTPDownloadInbound(c.info) {
+		c.limiter.UpdateUser(vCore.XHTTPDownloadTag(c.tag), added, deleted, modified)
+	}
+}
+
+func (c *Controller) applyAccountUsers(ctx context.Context, users []panel.UserInfo) (err error) {
+	defer func() {
+		if err != nil {
+			c.apiClient.ResetUserETag()
+			if c.accounts != nil {
+				for _, command := range c.accounts.pending {
+					if !command.Blocked {
+						_ = c.apiClient.AccountReceipt(ctx, c.accounts.instance, command, false)
+					}
+				}
+			}
+		}
+	}()
+	desired := make([]panel.UserInfo, 0, len(users))
+	for _, user := range users {
+		blocked := c.accounts != nil && c.accounts.blocked[user.Id]
+		command, releasing := panel.AccountCommand{}, false
+		if c.accounts != nil {
+			command, releasing = c.accounts.pending[user.Id]
+		}
+		if !blocked || releasing && !command.Blocked {
+			desired = append(desired, user)
+		}
+	}
+	deleted, added, modified := compareUserList(c.userList, desired)
+	if len(deleted) > 0 {
+		if err = c.server.DelUsers(deleted, c.tag, c.info); err != nil {
+			return err
+		}
+	}
+	if len(added) > 0 {
+		if _, err = c.server.AddUsers(&vCore.AddUsersParams{Tag: c.tag, NodeInfo: c.info, Users: added}); err != nil {
+			return err
+		}
+	}
+	c.updateAccountLimiter(added, deleted, modified)
+	c.userList = desired
+	if c.accounts != nil {
+		for uid, command := range c.accounts.pending {
+			if command.Blocked {
+				continue
+			}
+			delete(c.accounts.blocked, uid)
+			if receiptError := c.apiClient.AccountReceipt(ctx, c.accounts.instance, command, true); receiptError == nil {
+				delete(c.accounts.pending, uid)
+			}
+		}
+	}
+	return nil
+}

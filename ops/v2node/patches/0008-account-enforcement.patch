+		}
+		payload := make([]byte, 4)
+		if _, err = io.ReadFull(conn, payload); err != nil {
+			conn.Close()
+			return nil, err
+		}
+		if string(payload) != "ping" {
+			conn.Close()
+			return nil, fmt.Errorf("echo mismatch")
+		}
+		return conn, nil
+	}

+
+func TestTransportStaysTrackedAfterWriterHalfClose(t *testing.T) {
+	manager := &LinkManager{}
+	server, client := net.Pipe()
+	defer client.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	if !manager.TrackConnection(ctx, server) {
+		t.Fatal("transport rejected")
+	}
+	connection := &accountConnection{server}
+	writer := &ManagedWriter{writer: connection, manager: manager}
+	if !manager.AddLink(writer, connection) {
+		t.Fatal("link rejected")
+	}
+	// A protocol half-close removes its writer, but the authenticated transport
+	// still has a live direction and must remain eligible for forced cleanup.
+	manager.RemoveWriter(writer)
+	if err := manager.CloseAll(); err != nil {
+		t.Fatal(err)
+	}
+	_ = client.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := client.Read(make([]byte, 1)); err != io.EOF {
+		t.Fatal("transport survived cleanup", err)
+	}
+}
+
+type accountConnection struct{ net.Conn }
+
+func (c *accountConnection) WriteMultiBuffer(value buf.MultiBuffer) error { return nil }
+func (c *accountConnection) ReadMultiBuffer() (buf.MultiBuffer, error)    { return nil, io.EOF }
+func (c *accountConnection) Interrupt()                                   { _ = c.Close() }
+
+func TestAccountRevocationClosesExistingConnectionsWithoutReentrantLock(t *testing.T) {
+	manager := &LinkManager{links: make(map[*ManagedWriter]buf.Reader)}
+	server, client := net.Pipe()
+	defer client.Close()
+	connection := &accountConnection{server}
+	writer := &ManagedWriter{writer: connection, manager: manager}
+	if !manager.AddLink(writer, connection) {
+		t.Fatal("initial link rejected")
+	}
+	done := make(chan error, 1)
+	go func() { done <- manager.CloseAll() }()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("revocation deadlocked while closing a managed writer")
+	}
+	_ = client.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := client.Read(make([]byte, 1)); err != io.EOF {
+		t.Fatalf("existing connection survived revocation: %v", err)
+	}
+	if err := manager.CloseAll(); err != nil {
+		t.Fatal("repeated revocation not idempotent", err)
+	}
+	lateServer, lateClient := net.Pipe()
+	defer lateClient.Close()
+	late := &accountConnection{lateServer}
+	if manager.AddLink(&ManagedWriter{writer: late, manager: manager}, late) {
+		t.Fatal("late authenticated connection escaped closed manager")
+	}
+}
+
+func TestDeniedAccountRequiresExplicitRelease(t *testing.T) {
+	dispatcher := &DefaultDispatcher{}
+	if err := dispatcher.DenyUser("test|account"); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := dispatcher.DeniedUsers.Load("test|account"); !ok {
+		t.Fatal("account admission guard missing")
+	}
+	dispatcher.AllowUser("test|account")
+	if _, ok := dispatcher.DeniedUsers.Load("test|account"); ok {
+		t.Fatal("release did not restore admission")
+	}
+	if _, ok := dispatcher.LinkManagers.Load("test|account"); ok {
+		t.Fatal("release retained the closed connection manager")
+	}
+}

+package panel
+
+import (
+	"context"
+	"github.com/go-resty/resty/v2"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func TestEmptyUserSnapshotIsDifferentFromNotModifiedAndInvalidPayload(t *testing.T) {
+	cases := []struct {
+		name             string
+		code             int
+		body             string
+		valid, unchanged bool
+	}{
+		{"empty", 200, `{"users":[]}`, true, false},
+		{"304", 304, "", true, true},
+		{"missing", 200, `{}`, false, false},
+		{"null", 200, `{"users":null}`, false, false},
+		{"error status", 500, `{"users":[]}`, false, false},
+		{"duplicate", 200, `{"users":[{"id":1,"uuid":"a"},{"id":1,"uuid":"b"}]}`, false, false},
+	}
+	for _, item := range cases {
+		t.Run(item.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				w.Header().Set("ETag", "new")
+				w.WriteHeader(item.code)
+				_, _ = w.Write([]byte(item.body))
+			}))
+			defer server.Close()
+			client := &Client{client: resty.New().SetBaseURL(server.URL), userEtag: "old"}
+			users, err := client.GetUserList(context.Background())
+			if (err == nil) != item.valid {
+				t.Fatalf("valid=%v error=%v", item.valid, err)
+			}
+			if item.valid && (users == nil) != item.unchanged {
+				t.Fatalf("empty versus unchanged confused: %#v", users)
+			}
+			if (!item.valid || item.unchanged) && client.userEtag != "old" {
+				t.Fatal("invalid/unapplied response advanced the ETag")
+			}
+		})
+	}
+}
+
+func TestAccountCommandRequiresExplicitRestrictionState(t *testing.T) {
+	for _, body := range []string{
+		`{"commands":[{"user_id":101,"version":1,"delivery_id":"11111111-1111-4111-8111-111111111111"}],"next_cursor":0}`,
+		`{"commands":[{"user_id":101,"version":1,"blocked":null,"delivery_id":"11111111-1111-4111-8111-111111111111"}],"next_cursor":0}`,
+	} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(body))
+		}))
+		client := &Client{client: resty.New().SetBaseURL(server.URL)}
+		if _, err := client.AccountCommands(context.Background(), "isolated_runtime_0001"); err == nil {
+			t.Fatal("missing restriction state was treated as release")
+		}
+		server.Close()
+	}
+	secret := "synthetic+test/token"
+	message := redactPanelMessage("GET ?token="+url.QueryEscape(secret)+" "+secret, secret)
+	if strings.Contains(message, secret) || strings.Contains(message, url.QueryEscape(secret)) {
+		t.Fatal("request logger retained a synthetic API secret")
+	}
+}

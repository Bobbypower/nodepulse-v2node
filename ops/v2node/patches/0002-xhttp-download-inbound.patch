 package core
 
 import (
+	"encoding/json"
 	"fmt"
 
 	panel "github.com/wyx2685/v2node/api/v2board"
 )
 
+const xhttpDownloadTagSuffix = "-xhttp-download"
+
+func HasXHTTPDownloadInbound(info *panel.NodeInfo) bool {
+	return info != nil && info.Common != nil && info.Common.XHTTPDownloadInbound != nil &&
+		info.Common.XHTTPDownloadInbound.ServerPort > 0
+}
+
+func XHTTPDownloadTag(tag string) string {
+	return tag + xhttpDownloadTagSuffix
+}
+
+func xhttpDownloadNodeInfo(info *panel.NodeInfo) (*panel.NodeInfo, error) {
+	if !HasXHTTPDownloadInbound(info) {
+		return nil, nil
+	}
+	download := info.Common.XHTTPDownloadInbound
+	if download.Security != "" && download.Security != "none" {
+		return nil, fmt.Errorf("xhttp download inbound security must be none")
+	}
+	if download.Network != "" && download.Network != "xhttp" {
+		return nil, fmt.Errorf("xhttp download inbound network must be xhttp")
+	}
+	settings := download.NetworkSettings
+	if len(settings) == 0 {
+		settings, _ = json.Marshal(map[string]any{
+			"path": info.Common.XHTTPDownloadInboundPath(),
+			"mode": "auto",
+		})
+	}
+	clone := *info
+	common := *info.Common
+	common.ListenIP = download.ListenIP
+	if common.ListenIP == "" {
+		common.ListenIP = "0.0.0.0"
+	}
+	common.ServerPort = download.ServerPort
+	common.Network = "xhttp"
+	common.NetworkSettings = settings
+	common.Tls = panel.None
+	common.TlsSettings = panel.TlsSettings{}
+	common.XHTTPDownloadInbound = nil
+	clone.Security = panel.None
+	clone.Common = &common
+	return &clone, nil
+}

+		return fmt.Errorf("build xhttp download inbound info error: %s", err)
+	}
+	if downloadInfo != nil {
+		downloadInbound, err := buildInbound(downloadInfo, XHTTPDownloadTag(tag))
+		if err != nil {
+			_ = v.removeInbound(tag)
+			return fmt.Errorf("build xhttp download inbound error: %s", err)
+		}
+		if err := v.addInbound(downloadInbound); err != nil {
+			_ = v.removeInbound(tag)
+			return fmt.Errorf("add xhttp download inbound error: %s", err)
+		}
+	}
 	return nil
 }
 

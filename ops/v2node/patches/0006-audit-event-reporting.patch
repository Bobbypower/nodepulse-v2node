diff --git a/core/audit.go b/core/audit.go
new file mode 100644
index 0000000..fc65685
--- /dev/null
+++ b/core/audit.go
@@ -0,0 +1,88 @@
+package core
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	panel "github.com/wyx2685/v2node/api/v2board"
+	"github.com/wyx2685/v2node/core/app/dispatcher"
+)
+
+const maxPendingAuditEvents = 1024
+
+func (v *V2Core) captureAuditHit(hit dispatcher.AuditHit) {
+	parts := strings.SplitN(hit.RuleTag, ":", 4)
+	if len(parts) != 4 || parts[0] != "audit" {
+		return
+	}
+	nodeID, nodeErr := strconv.Atoi(parts[1])
+	ruleID, ruleErr := strconv.Atoi(parts[2])
+	if nodeErr != nil || ruleErr != nil || nodeID <= 0 || ruleID <= 0 {
+		return
+	}
+	violationType := parts[3]
+	switch violationType {
+	case "block", "block_ip", "block_port", "protocol":
+	default:
+		return
+	}
+
+	v.users.mapLock.RLock()
+	userID := v.users.uidMap[hit.User]
+	v.users.mapLock.RUnlock()
+	if userID <= 0 {
+		return
+	}
+	occurredAt := hit.OccurredAt.UTC()
+	minute := occurredAt.Truncate(time.Minute).Unix()
+	digest := sha256.Sum256([]byte(fmt.Sprintf("%d:%d:%d:%s:%d", nodeID, userID, ruleID, violationType, minute)))
+	eventID := fmt.Sprintf("%x", digest[:])
+
+	v.auditMu.Lock()
+	defer v.auditMu.Unlock()
+	if _, exists := v.auditQueue[eventID]; exists || len(v.auditQueue) >= maxPendingAuditEvents {
+		return
+	}
+	v.auditQueue[eventID] = panel.AuditEvent{
+		EventID:       eventID,
+		NodeID:        nodeID,
+		UserID:        userID,
+		RuleID:        ruleID,
+		ViolationType: violationType,
+		OccurredAt:    occurredAt,
+	}
+}
+
+func (v *V2Core) DrainAuditEvents(nodeID int, limit int) []panel.AuditEvent {
+	if limit <= 0 {
+		limit = 256
+	}
+	v.auditMu.Lock()
+	defer v.auditMu.Unlock()
+	events := make([]panel.AuditEvent, 0, limit)
+	for eventID, event := range v.auditQueue {
+		if event.NodeID != nodeID {
+			continue
+		}
+		events = append(events, event)
+		delete(v.auditQueue, eventID)
+		if len(events) >= limit {
+			break
+		}
+	}
+	return events
+}
+
+func (v *V2Core) RequeueAuditEvents(events []panel.AuditEvent) {
+	v.auditMu.Lock()
+	defer v.auditMu.Unlock()
+	for _, event := range events {
+		if len(v.auditQueue) >= maxPendingAuditEvents {
+			return
+		}
+		v.auditQueue[event.EventID] = event
+	}
+}

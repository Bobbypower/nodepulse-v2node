@@ -0,0 +1,64 @@
+package core
+
+import (
+	"testing"
+	"time"
+
+	panel "github.com/wyx2685/v2node/api/v2board"
+	"github.com/wyx2685/v2node/conf"
+	"github.com/wyx2685/v2node/core/app/dispatcher"
+)
+
+func TestAuditCollectorDeduplicatesAndRequeues(t *testing.T) {
+	v := New(&conf.Conf{})
+	v.users.uidMap["node-user"] = 42
+	now := time.Date(2026, 9, 22, 5, 0, 15, 0, time.UTC)
+	hit := dispatcher.AuditHit{
+		RuleTag:    "audit:7:3:block",
+		User:       "node-user",
+		OccurredAt: now,
+	}
+	v.captureAuditHit(hit)
+	hit.OccurredAt = now.Add(20 * time.Second)
+	v.captureAuditHit(hit)
+
+	events := v.DrainAuditEvents(7, 256)
+	if len(events) != 1 {
+		t.Fatalf("DrainAuditEvents() returned %d events, want 1", len(events))
+	}
+	event := events[0]
+	if event.NodeID != 7 || event.UserID != 42 || event.RuleID != 3 || event.ViolationType != "block" {
+		t.Fatalf("unexpected event: %#v", event)
+	}
+	if event.EventID == "" {
+		t.Fatal("event ID is empty")
+	}
+
+	v.RequeueAuditEvents(events)
+	if got := v.DrainAuditEvents(7, 256); len(got) != 1 || got[0].EventID != event.EventID {
+		t.Fatalf("requeued events = %#v, want original event", got)
+	}
+}
+
+func TestCustomBlockRoutesCarryAuditRuleTags(t *testing.T) {
+	actionValue := "tcp"
+	info := &panel.NodeInfo{
+		Id:  7,
+		Tag: "node-7",
+		Common: &panel.CommonNode{Routes: []panel.Route{
+			{Id: 3, Match: []string{"domain:canary.invalid"}, Action: "block"},
+			{Id: 4, Match: []string{"25"}, Action: "block_port", ActionValue: &actionValue},
+		}},
+	}
+	_, _, routes, err := GetCustomConfig([]*panel.NodeInfo{info})
+	if err != nil {
+		t.Fatalf("GetCustomConfig() error = %v", err)
+	}
+	tags := map[string]bool{}
+	for _, rule := range routes.GetRule() {
+		tags[rule.GetRuleTag()] = true
+	}
+	if !tags["audit:7:3:block"] || !tags["audit:7:4:block_port"] {
+		t.Fatalf("audit rule tags missing: %#v", tags)
+	}
+}

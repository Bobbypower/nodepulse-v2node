+package panel
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/go-resty/resty/v2"
+)
+
+func TestReportAuditEventsSendsCapabilityHeartbeat(t *testing.T) {
+	var received AuditBatch
+	var rawBody []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/v1/server/UniProxy/audit" {
+			t.Fatalf("path = %s", r.URL.Path)
+		}
+		if r.URL.Query().Get("node_id") != "7" || r.URL.Query().Get("token") != "token" {
+			t.Fatalf("query = %s", r.URL.RawQuery)
+		}
+		var err error
+		rawBody, err = io.ReadAll(r.Body)
+		if err != nil {
+			t.Fatalf("read request: %v", err)
+		}
+		if err := json.Unmarshal(rawBody, &received); err != nil {
+			t.Fatalf("decode request: %v", err)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"status":"ok"}`))
+	}))
+	defer server.Close()
+
+	client := &Client{client: resty.New().SetBaseURL(server.URL).SetQueryParams(map[string]string{
+		"node_type": "v2node",
+		"node_id":   "7",
+		"token":     "token",
+	})}
+	if err := client.ReportAuditEvents(context.Background(), nil); err != nil {
+		t.Fatalf("ReportAuditEvents() error = %v", err)
+	}
+	if received.CapabilityVersion != "1" || len(received.Events) != 0 {
+		t.Fatalf("received batch = %#v", received)
+	}
+	if !bytes.Contains(rawBody, []byte(`"events":[]`)) {
+		t.Fatalf("heartbeat must encode an empty events array: %s", rawBody)
+	}
+}

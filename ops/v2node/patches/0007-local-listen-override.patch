+func applyLocalEndpointOverride(config *conf.NodeConfig, info *panel.NodeInfo) {
+	if config == nil || info == nil || info.Common == nil {
+		return
+	}
+	if config.ListenIP != "" {
+		info.Common.ListenIP = config.ListenIP
+	}
+	if config.ListenPort > 0 {
+		info.Common.ServerPort = config.ListenPort
+	}

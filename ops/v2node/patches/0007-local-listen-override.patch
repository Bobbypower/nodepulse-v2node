@@ -0,0 +1,38 @@
+package node
+
+import (
+	"testing"
+
+	panel "github.com/wyx2685/v2node/api/v2board"
+	"github.com/wyx2685/v2node/conf"
+)
+
+func TestApplyLocalEndpointOverride(t *testing.T) {
+	info := &panel.NodeInfo{Common: &panel.CommonNode{
+		ListenIP:   "0.0.0.0",
+		ServerPort: 23334,
+	}}
+	config := &conf.NodeConfig{ListenIP: "::", ListenPort: 23335}
+
+	applyLocalEndpointOverride(config, info)
+
+	if info.Common.ListenIP != "::" {
+		t.Fatalf("listen IP = %q, want ::", info.Common.ListenIP)
+	}
+	if info.Common.ServerPort != 23335 {
+		t.Fatalf("listen port = %d, want 23335", info.Common.ServerPort)
+	}
+}
+
+func TestApplyLocalEndpointOverrideKeepsPanelEndpointByDefault(t *testing.T) {
+	info := &panel.NodeInfo{Common: &panel.CommonNode{
+		ListenIP:   "0.0.0.0",
+		ServerPort: 23334,
+	}}
+
+	applyLocalEndpointOverride(&conf.NodeConfig{}, info)
+
+	if info.Common.ListenIP != "0.0.0.0" || info.Common.ServerPort != 23334 {
+		t.Fatalf("endpoint = %s:%d, want panel endpoint", info.Common.ListenIP, info.Common.ServerPort)
+	}
+}

-			traffic.UpCounter.Store(0)
-			traffic.DownCounter.Store(0)
-		}
-		trafficSlice = append(trafficSlice, *total)
+		// The loads above decide eligibility only. Each atomic swap returns
+		// the exact increment it removed, including traffic since those loads.
+		total.Upload, total.Download = drainReportCounters(storages[uid])
+		if total.Upload != 0 || total.Download != 0 {
+			trafficSlice = append(trafficSlice, *total)
+		}
 	}
 	if len(trafficSlice) == 0 {
 		return nil, nil
 	}
 	return trafficSlice, nil
+}
+
+func drainReportCounters(storages []*counter.TrafficStorage) (upload, download int64) {
+	for _, traffic := range storages {
+		upload += traffic.UpCounter.Swap(0)
+		download += traffic.DownCounter.Swap(0)
+	}
+	return upload, download
 }
 

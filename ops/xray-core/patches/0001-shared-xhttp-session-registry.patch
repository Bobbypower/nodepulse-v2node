diff --git a/transport/internet/splithttp/shared_session_test.go b/transport/internet/splithttp/shared_session_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/splithttp/shared_session_test.go
@@ -0,0 +1,24 @@
+package splithttp
+
+import "testing"
+
+func TestSharedSessionRegistryForPath(t *testing.T) {
+	path := "/" + t.Name()
+	first := sharedSessionRegistryForPath(path)
+	second := sharedSessionRegistryForPath(path)
+	other := sharedSessionRegistryForPath(path + "-other")
+
+	if first != second {
+		t.Fatal("handlers with the same path must share a session registry")
+	}
+	if first == other {
+		t.Fatal("handlers with different paths must not share a session registry")
+	}
+
+	const sessionID = "test-session"
+	first.sessions.Store(sessionID, &httpSession{})
+	defer first.sessions.Delete(sessionID)
+	if _, ok := second.sessions.Load(sessionID); !ok {
+		t.Fatal("session inserted by one handler is not visible to the other")
+	}
+}

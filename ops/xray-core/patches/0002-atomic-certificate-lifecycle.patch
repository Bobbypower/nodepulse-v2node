diff --git a/common/platform/filesystem/cert_pair.go b/common/platform/filesystem/cert_pair.go
new file mode 100644
--- /dev/null
+++ b/common/platform/filesystem/cert_pair.go
@@ -0,0 +1,300 @@
+package filesystem
+
+// NodePulse stores a complete PEM pair in the private key file. A single rename
+// publishes that pair; the public certificate file is a certificate-only mirror.
+// Readers of managed pairs must read the key file once, rather than combining
+// two independently changing files. Legacy separate PEM files remain readable.
+
+import (
+	"bytes"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+const maxCertificateFile = 4 << 20
+
+func certificatePEM(data []byte) []byte {
+	var result []byte
+	for len(data) > 0 {
+		block, rest := pem.Decode(data)
+		if block == nil {
+			break
+		}
+		if block.Type == "CERTIFICATE" {
+			result = append(result, pem.EncodeToMemory(block)...)
+		}
+		data = rest
+	}
+	return result
+}
+
+func ReadCertificatePair(certPath, keyPath string) ([]byte, []byte, error) {
+	key, err := ReadPrivateFile(keyPath)
+	if err != nil {
+		return nil, nil, err
+	}
+	cert := certificatePEM(key)
+	if len(cert) == 0 {
+		cert, err = ReadCert(certPath)
+		if err != nil {
+			return nil, nil, err
+		}
+	}
+	if _, err = tls.X509KeyPair(cert, key); err != nil {
+		return nil, nil, errors.New("certificate and private key do not form a valid pair")
+	}
+	return cert, key, nil
+}
+
+// ValidateCertificatePair checks the intended name, validity period and key pair.
+// It does not establish a public trust chain; that is an issuer/deployment check.
+func ValidateCertificatePair(cert, key []byte, domain string, now time.Time) error {
+	pair, err := tls.X509KeyPair(cert, key)
+	if err != nil {
+		return errors.New("invalid certificate and private key pair")
+	}
+	leaf, err := x509.ParseCertificate(pair.Certificate[0])
+	if err != nil {
+		return errors.New("invalid leaf certificate")
+	}
+	if now.Before(leaf.NotBefore) || !now.Before(leaf.NotAfter) {
+		return errors.New("certificate is not currently valid")
+	}
+	if domain != "" {
+		if err := leaf.VerifyHostname(domain); err != nil {
+			return errors.New("certificate does not cover the intended name")
+		}
+	}
+	return nil
+}
+
+func safeParent(name string) error {
+	if !filepath.IsAbs(name) {
+		return errors.New("certificate paths must be absolute")
+	}
+	parent := filepath.Dir(filepath.Clean(name))
+	// Check every existing ancestor before creating anything beneath it.
+	for existing := parent; ; existing = filepath.Dir(existing) {
+		if _, err := os.Lstat(existing); err == nil {
+			if err := checkCertificateParents(existing); err != nil {
+				return err
+			}
+			break
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+	}
+	if err := os.MkdirAll(parent, 0700); err != nil {
+		return err
+	}
+	return checkCertificateParents(parent)
+}
+
+func EnsurePrivateDirectory(name string) error {
+	if err := safeParent(filepath.Join(name, "state")); err != nil {
+		return err
+	}
+	return restrictCertificateDirectory(name)
+}
+
+func WithPrivateFileLock(name string, execute func() error) error {
+	if err := safeParent(name); err != nil {
+		return err
+	}
+	return withCertificateLock(name, execute)
+}
+
+func atomicCertificateFile(name string, data []byte, mode os.FileMode) (published bool, err error) {
+	if err = safeParent(name); err != nil {
+		return false, err
+	}
+	if info, statErr := os.Lstat(name); statErr == nil {
+		if err = checkCertificateOwner(info); err != nil {
+			return false, err
+		}
+	} else if !os.IsNotExist(statErr) {
+		return false, statErr
+	}
+	f, err := os.CreateTemp(filepath.Dir(name), ".nodepulse-cert-*")
+	if err != nil {
+		return false, err
+	}
+	defer os.Remove(f.Name())
+	defer f.Close()
+	if err = f.Chmod(mode); err != nil {
+		return false, err
+	}
+	if _, err = f.Write(data); err != nil {
+		return false, err
+	}
+	if err = f.Sync(); err != nil {
+		return false, err
+	}
+	if err = f.Close(); err != nil {
+		return false, err
+	}
+	dir, err := os.Open(filepath.Dir(name))
+	if err != nil {
+		return false, err
+	}
+	defer dir.Close()
+	// Check durability support before the commit point.
+	if err = dir.Sync(); err != nil {
+		return false, err
+	}
+	if err = os.Rename(f.Name(), name); err != nil {
+		return false, err
+	}
+	return true, dir.Sync()
+}
+
+// WritePrivateFile creates or replaces an owner-only file without truncating an
+// existing key/account file on an encoding or write failure.
+func WritePrivateFile(name string, data []byte) error {
+	if len(data) > maxCertificateFile {
+		return errors.New("private file is too large")
+	}
+	_, err := atomicCertificateFile(name, data, 0600)
+	return err
+}
+
+func ReadPrivateFile(name string) ([]byte, error) {
+	return readPrivateFile(name, true)
+}
+
+// ReadPrivateFileStrict performs no permission changes; approved host profiles
+// must already have owner-only permissions before a read-only preflight.
+func ReadPrivateFileStrict(name string) ([]byte, error) { return readPrivateFile(name, false) }
+
+func readPrivateFile(name string, harden bool) ([]byte, error) {
+	if !filepath.IsAbs(name) {
+		return nil, errors.New("certificate paths must be absolute")
+	}
+	if err := checkCertificateParents(filepath.Dir(name)); err != nil {
+		return nil, err
+	}
+	f, err := openCertificatePrivateFile(name)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if err := checkCertificateOwner(info); err != nil {
+		return nil, err
+	}
+	if info.Mode().Perm() != 0600 {
+		if !harden {
+			return nil, errors.New("approved private file must already have mode 0600")
+		}
+		if err := f.Chmod(0600); err != nil {
+			return nil, fmt.Errorf("cannot restrict private file for runtime uid %d: %w", os.Geteuid(), err)
+		}
+	}
+	data, err := io.ReadAll(io.LimitReader(f, maxCertificateFile+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxCertificateFile {
+		return nil, errors.New("private file is too large")
+	}
+	return data, nil
+}
+
+// WriteCertificatePair keeps the previous authoritative pair on pre-commit
+// failure. The last successful pair is also retained in keyPath.previous (0600).
+// A post-rename directory-sync error is explicitly identified as published;
+// callers must check the active fingerprint rather than assume a rollback.
+func WriteCertificatePair(certPath, keyPath string, cert, key []byte, domain string) error {
+	return writeCertificatePair(certPath, keyPath, cert, key, domain, nil)
+}
+
+func writeCertificatePair(certPath, keyPath string, cert, key []byte, domain string, beforeCommit func() error) error {
+	if filepath.Clean(certPath) == filepath.Clean(keyPath) {
+		return errors.New("certificate and key paths must differ")
+	}
+	if err := ValidateCertificatePair(cert, key, domain, time.Now()); err != nil {
+		return err
+	}
+	cert = certificatePEM(cert)
+	if len(cert)+len(key) > maxCertificateFile {
+		return errors.New("certificate pair is too large")
+	}
+	if err := safeParent(keyPath); err != nil {
+		return err
+	}
+	return withCertificateLock(keyPath+".lock", func() error {
+		var oldCert, oldKey []byte
+		if _, err := os.Lstat(keyPath); err == nil {
+			var readErr error
+			oldCert, oldKey, readErr = ReadCertificatePair(certPath, keyPath)
+			if readErr != nil {
+				return readErr
+			}
+			// Bootstrap old separate files into a complete private PEM before
+			// replacing the public mirror. A crash can then expose only a valid
+			// old or new pair to the paired reader.
+			oldBundle := append(append([]byte{}, oldCert...), '\n')
+			oldBundle = append(oldBundle, privateKeyPEM(oldKey)...)
+			if _, err := atomicCertificateFile(keyPath, oldBundle, 0600); err != nil {
+				return err
+			}
+			if err := WritePrivateFile(keyPath+".previous", oldBundle); err != nil {
+				return err
+			}
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+		if _, err := atomicCertificateFile(certPath, cert, 0644); err != nil {
+			return err
+		}
+		rollbackMirror := func() {
+			if oldCert != nil {
+				_, _ = atomicCertificateFile(certPath, oldCert, 0644)
+			} else {
+				_ = os.Remove(certPath)
+			}
+		}
+		if beforeCommit != nil {
+			if err := beforeCommit(); err != nil {
+				rollbackMirror()
+				return err
+			}
+		}
+		bundle := append(append([]byte{}, cert...), '\n')
+		bundle = append(bundle, privateKeyPEM(key)...)
+		published, err := atomicCertificateFile(keyPath, bundle, 0600)
+		if err != nil {
+			if !published {
+				rollbackMirror()
+				return err
+			}
+			return fmt.Errorf("certificate pair published but directory durability confirmation failed: %w", err)
+		}
+		return nil
+	})
+}
+
+func privateKeyPEM(data []byte) []byte {
+	var result []byte
+	for len(data) > 0 {
+		block, rest := pem.Decode(data)
+		if block == nil {
+			break
+		}
+		if bytes.HasSuffix([]byte(block.Type), []byte("PRIVATE KEY")) {
+			result = append(result, pem.EncodeToMemory(block)...)
+		}
+		data = rest
+	}
+	return result
+}
diff --git a/common/platform/filesystem/cert_owner_linux.go b/common/platform/filesystem/cert_owner_linux.go
new file mode 100644
--- /dev/null
+++ b/common/platform/filesystem/cert_owner_linux.go
@@ -0,0 +1,85 @@
+//go:build linux
+
+package filesystem
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+func checkCertificateOwner(info os.FileInfo) error {
+	s, ok := info.Sys().(*syscall.Stat_t)
+	// A reader may hold the previous inode after an atomic rename (Nlink=0).
+	// It is still private and immutable to other users; hard links are rejected.
+	if !ok || !info.Mode().IsRegular() || int(s.Uid) != os.Geteuid() || s.Nlink > 1 {
+		return errors.New("private certificate files must be regular, singly linked and owned by the runtime uid")
+	}
+	return nil
+}
+
+func checkCertificateParents(name string) error {
+	for {
+		info, err := os.Lstat(name)
+		if err != nil {
+			return err
+		}
+		s, ok := info.Sys().(*syscall.Stat_t)
+		if !ok || !info.IsDir() || (s.Uid != 0 && int(s.Uid) != os.Geteuid()) {
+			return errors.New("certificate parent must be a real directory owned by root or runtime uid")
+		}
+		if info.Mode().Perm()&0022 != 0 && info.Mode()&os.ModeSticky == 0 {
+			return errors.New("certificate parent is writable by another user")
+		}
+		parent := filepath.Dir(name)
+		if parent == name {
+			return nil
+		}
+		name = parent
+	}
+}
+
+func openCertificatePrivateFile(name string) (*os.File, error) {
+	fd, err := syscall.Open(name, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	return os.NewFile(uintptr(fd), name), nil
+}
+
+func restrictCertificateDirectory(name string) error {
+	info, err := os.Lstat(name)
+	if err != nil {
+		return err
+	}
+	s, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || !info.IsDir() || int(s.Uid) != os.Geteuid() {
+		return errors.New("private account directory must be owned by runtime uid")
+	}
+	return os.Chmod(name, 0700)
+}
+
+func withCertificateLock(name string, execute func() error) error {
+	fd, err := syscall.Open(name, syscall.O_CREAT|syscall.O_RDWR|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0600)
+	if err != nil {
+		return err
+	}
+	f := os.NewFile(uintptr(fd), name)
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return err
+	}
+	if err = checkCertificateOwner(info); err != nil {
+		return err
+	}
+	if err = f.Chmod(0600); err != nil {
+		return err
+	}
+	if err = syscall.Flock(fd, syscall.LOCK_EX); err != nil {
+		return err
+	}
+	defer syscall.Flock(fd, syscall.LOCK_UN)
+	return execute()
+}

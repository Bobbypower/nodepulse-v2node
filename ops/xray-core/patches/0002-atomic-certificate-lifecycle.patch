+func TestPrivateFileLinksAndUntrustedParentsRejected(t *testing.T) {
+	dir := t.TempDir()
+	real := filepath.Join(dir, "real")
+	if err := os.WriteFile(real, []byte("synthetic"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	sym := filepath.Join(dir, "symlink")
+	if err := os.Symlink(real, sym); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ReadPrivateFile(sym); err == nil {
+		t.Fatal("read symlink")
+	}
+	if err := WritePrivateFile(sym, []byte("new")); err == nil {
+		t.Fatal("replaced symlink")
+	}
+	hard := filepath.Join(dir, "hard")
+	if err := os.Link(real, hard); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ReadPrivateFile(hard); err == nil {
+		t.Fatal("read hardlink")
+	}
+	bad := filepath.Join(dir, "writable")
+	os.Mkdir(bad, 0777)
+	os.Chmod(bad, 0777)
+	if err := WritePrivateFile(filepath.Join(bad, "key"), []byte("x")); err == nil {
+		t.Fatal("accepted shared writable directory")
+	}
+	parentSym := filepath.Join(dir, "parent-link")
+	os.Symlink(bad, parentSym)
+	if err := WritePrivateFile(filepath.Join(parentSym, "new", "key"), []byte("x")); err == nil {
+		t.Fatal("accepted symlink parent")
+	}
+	if _, err := os.Stat(filepath.Join(bad, "new")); !os.IsNotExist(err) {
+		t.Fatal("created directory before rejecting symlink")
+	}
+}
+
+func TestPrivateAccountFileAndDirectoryPermissions(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "account")
+	if err := EnsurePrivateDirectory(dir); err != nil {
+		t.Fatal(err)
+	}
+	assertMode(t, dir, 0700)
+	name := filepath.Join(dir, "account.json")
+	if err := os.WriteFile(name, []byte("synthetic-account"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ReadPrivateFileStrict(name); err == nil {
+		t.Fatal("read-only preflight accepted insecure mode")
+	}
+	assertMode(t, name, 0644)
+	if _, err := ReadPrivateFile(name); err != nil {
+		t.Fatal(err)
+	}
+	assertMode(t, name, 0600)
+	if err := WritePrivateFile(name, []byte("updated-synthetic-account")); err != nil {
+		t.Fatal(err)
+	}
+	assertMode(t, name, 0600)
+}
+
+func TestConcurrentReadersNeverObserveMixedPair(t *testing.T) {
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert"), filepath.Join(dir, "key")
+	a, ak := testPair(t, "node.example.invalid", time.Now().Add(90*24*time.Hour))
+	b, bk := testPair(t, "node.example.invalid", time.Now().Add(100*24*time.Hour))
+	if err := WriteCertificatePair(cp, kp, a, ak, "node.example.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	failures := make(chan error, 1000)
+	wg.Go(func() {
+		for range 30 {
+			if err := WriteCertificatePair(cp, kp, b, bk, "node.example.invalid"); err != nil {
+				failures <- err
+			}
+			if err := WriteCertificatePair(cp, kp, a, ak, "node.example.invalid"); err != nil {
+				failures <- err
+			}
+		}
+	})
+	for range 4 {
+		wg.Go(func() {
+			for range 200 {
+				if _, _, err := ReadCertificatePair(cp, kp); err != nil {
+					failures <- err
+				}
+			}
+		})
+	}
+	wg.Wait()
+	close(failures)
+	for err := range failures {
+		t.Error(err)
+	}
+}

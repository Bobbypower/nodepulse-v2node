+	cert := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
+	key := pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: private})
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert"), filepath.Join(dir, "key")
+	if err := filesystem.WriteCertificatePair(cp, kp, cert, key, "node.example.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	os.Remove(cp)
+	built, err := (&TLSCertConfig{CertFile: cp, KeyFile: kp}).Build()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := x509.ParseCertificate(der); err != nil || len(built.Certificate) == 0 || len(built.Key) == 0 {
+		t.Fatal("authoritative pair not loaded")
+	}
+	// A legacy mismatched pair must fail before listener creation.
+	other, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	otherDER, _ := x509.MarshalECPrivateKey(other)
+	os.WriteFile(cp, cert, 0644)
+	os.WriteFile(kp, pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: otherDER}), 0600)
+	if _, err := (&TLSCertConfig{CertFile: cp, KeyFile: kp}).Build(); err == nil {
+		t.Fatal("mismatched legacy pair accepted")
+	}
+}

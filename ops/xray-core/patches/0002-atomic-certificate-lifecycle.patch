+func reloadTestPair(t *testing.T) ([]byte, []byte) {
+	t.Helper()
+	k, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	serial, _ := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	c := &x509.Certificate{SerialNumber: serial, DNSNames: []string{"node.example.invalid"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(90 * 24 * time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	der, err := x509.CreateCertificate(rand.Reader, c, c, k.Public(), k)
+	if err != nil {
+		t.Fatal(err)
+	}
+	key, _ := x509.MarshalECPrivateKey(k)
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: key})
+}
+
+func TestReloadKeepsPairOnReadAndValidationFailures(t *testing.T) {
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert"), filepath.Join(dir, "key")
+	a, ak := reloadTestPair(t)
+	b, bk := reloadTestPair(t)
+	entry := &Certificate{Certificate: a, Key: ak, CertificatePath: cp, KeyPath: kp}
+	if _, err := reloadCertificatePair(entry); err == nil {
+		t.Fatal("missing files accepted")
+	}
+	if !bytes.Equal(entry.Certificate, a) {
+		t.Fatal("active cert changed")
+	}
+	os.WriteFile(cp, b, 0644)
+	os.WriteFile(kp, ak, 0600)
+	if _, err := reloadCertificatePair(entry); err == nil {
+		t.Fatal("mixed pair accepted")
+	}
+	if !bytes.Equal(entry.Certificate, a) {
+		t.Fatal("active cert changed on mismatch")
+	}
+	os.WriteFile(kp, bk, 0600)
+	changed, err := reloadCertificatePair(entry)
+	if err != nil || !changed || !bytes.Equal(entry.Certificate, b) {
+		t.Fatalf("failed to recover: %v", err)
+	}
+}
+
+func TestCertificateWatcherStops(t *testing.T) {
+	stop := make(chan struct{})
+	done := setupOcspTicker(&Certificate{OcspStapling: 3600}, func(bool, bool) {}, stop)
+	close(stop)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("certificate watcher did not stop")
+	}
+}
+
+func TestActualTLSHandshakeRecoversAfterFailedReload(t *testing.T) {
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert"), filepath.Join(dir, "key")
+	a, ak := reloadTestPair(t)
+	b, bk := reloadTestPair(t)
+	if err := filesystem.WriteCertificatePair(cp, kp, a, ak, "node.example.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	cert, key, err := filesystem.ReadCertificatePair(cp, kp)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config := (&Config{Certificate: []*Certificate{{Certificate: cert, Key: key, CertificatePath: cp, KeyPath: kp}}, RejectUnknownSni: true}).GetTLSConfig()
+	listener, err := ctls.Listen("tcp", "127.0.0.1:0", config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go func(conn net.Conn) {
+				defer conn.Close()
+				conn.SetDeadline(time.Now().Add(2 * time.Second))
+				conn.(*ctls.Conn).Handshake()
+			}(conn)
+		}
+	}()
+	pool := x509.NewCertPool()
+	pool.AppendCertsFromPEM(a)
+	pool.AppendCertsFromPEM(b)
+	observed := func() []byte {
+		t.Helper()
+		conn, err := ctls.DialWithDialer(&net.Dialer{Timeout: 2 * time.Second}, "tcp", listener.Addr().String(), &ctls.Config{RootCAs: pool, ServerName: "node.example.invalid"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		return conn.ConnectionState().PeerCertificates[0].Raw
+	}
+	blockA, _ := pem.Decode(a)
+	blockB, _ := pem.Decode(b)
+	if !bytes.Equal(observed(), blockA.Bytes) {
+		t.Fatal("old pair not served")
+	}
+	// Let a real watcher encounter a missing key; it must keep serving old TLS.
+	if err := os.Rename(kp, kp+".saved"); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(5500 * time.Millisecond)
+	if !bytes.Equal(observed(), blockA.Bytes) {
+		t.Fatal("lost active TLS on read failure")
+	}
+	if err := os.Rename(kp+".saved", kp); err != nil {
+		t.Fatal(err)
+	}
+	if err := filesystem.WriteCertificatePair(cp, kp, b, bk, "node.example.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(8 * time.Second)
+	for {
+		if bytes.Equal(observed(), blockB.Bytes) {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("watcher failed to load renewed certificate after error")
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+}

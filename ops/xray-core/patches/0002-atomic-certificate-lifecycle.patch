diff --git a/common/platform/filesystem/cert_pair_test.go b/common/platform/filesystem/cert_pair_test.go
new file mode 100644
--- /dev/null
+++ b/common/platform/filesystem/cert_pair_test.go
@@ -0,0 +1,313 @@
+//go:build linux
+
+package filesystem
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"errors"
+	"math/big"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestStoreRejectsRootRealUIDWithDroppedEffectiveUID(t *testing.T) {
+	if os.Getenv("NODEPULSE_CERT_EUID_CHILD") == "1" {
+		if err := syscall.Setresuid(0, 65534, 65534); err != nil {
+			t.Fatal(err)
+		}
+		if os.Getuid() != 0 || os.Geteuid() != 65534 {
+			t.Fatal("failed to create controlled real/effective uid difference")
+		}
+		status, err := os.ReadFile("/proc/self/status")
+		if err != nil {
+			t.Fatal(err)
+		}
+		found := false
+		for _, line := range strings.Split(string(status), "\n") {
+			if strings.HasPrefix(line, "Uid:") {
+				ids := strings.Fields(line)
+				found = len(ids) == 5 && ids[1] == "0" && ids[2] == "65534" && ids[4] == "65534"
+			}
+		}
+		if !found {
+			t.Fatal("proc uid layout did not demonstrate the real/effective difference")
+		}
+		if _, err := ReadPrivateFile(os.Getenv("NODEPULSE_CERT_EUID_ROOT_KEY")); err == nil {
+			t.Fatal("dropped effective uid read a root-only key")
+		}
+		return
+	}
+	if os.Geteuid() != 0 {
+		t.Skip("root launcher needed for controlled effective uid drop")
+	}
+	dir := t.TempDir()
+	os.Chmod(dir, 0755)
+	os.Chmod(filepath.Dir(dir), 0755)
+	key := filepath.Join(dir, "root-key")
+	os.WriteFile(key, []byte("synthetic"), 0600)
+	executable, _ := os.Executable()
+	command := exec.Command(executable, "-test.run=^TestStoreRejectsRootRealUIDWithDroppedEffectiveUID$", "-test.v")
+	command.Env = append(os.Environ(), "NODEPULSE_CERT_EUID_CHILD=1", "NODEPULSE_CERT_EUID_ROOT_KEY="+key)
+	if out, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("effective uid negative check: %v: %s", err, out)
+	}
+}
+
+func TestStoreRuntimeUID(t *testing.T) {
+	if os.Getenv("NODEPULSE_CERT_UID_CHILD") == "1" {
+		dir := os.Getenv("NODEPULSE_CERT_UID_DIR")
+		if os.Geteuid() != 65534 {
+			t.Fatal("child uid was not changed")
+		}
+		if _, err := ReadPrivateFile(filepath.Join(filepath.Dir(dir), "root-owned")); err == nil {
+			t.Fatal("read another runtime identity's key")
+		}
+		cert, key := testPair(t, "node.example.invalid", time.Now().Add(90*24*time.Hour))
+		if err := WriteCertificatePair(filepath.Join(dir, "cert"), filepath.Join(dir, "key"), cert, key, "node.example.invalid"); err != nil {
+			t.Fatal(err)
+		}
+		assertMode(t, filepath.Join(dir, "key"), 0600)
+		return
+	}
+	if os.Geteuid() != 0 {
+		t.Skip("root launcher needed for controlled runtime uid switch")
+	}
+	dir := t.TempDir()
+	os.Chmod(dir, 0755)
+	os.Chmod(filepath.Dir(dir), 0755)
+	child := filepath.Join(dir, "child")
+	os.Mkdir(child, 0700)
+	os.Chown(child, 65534, 65534)
+	os.WriteFile(filepath.Join(dir, "root-owned"), []byte("synthetic"), 0644)
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	command := exec.Command(executable, "-test.run=^TestStoreRuntimeUID$", "-test.v")
+	command.Env = append(os.Environ(), "NODEPULSE_CERT_UID_CHILD=1", "NODEPULSE_CERT_UID_DIR="+child)
+	command.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: 65534, Gid: 65534}}
+	if out, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("runtime uid check: %v: %s", err, out)
+	}
+}
+
+func testPair(t *testing.T, name string, end time.Time) ([]byte, []byte) {
+	t.Helper()
+	k, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	serial, _ := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 128))
+	c := &x509.Certificate{SerialNumber: serial, Subject: pkix.Name{CommonName: name}, DNSNames: []string{name}, NotBefore: time.Now().Add(-time.Hour), NotAfter: end, KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	der, err := x509.CreateCertificate(rand.Reader, c, c, k.Public(), k)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pk, _ := x509.MarshalECPrivateKey(k)
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: pk})
+}
+
+func assertMode(t *testing.T, p string, want os.FileMode) {
+	t.Helper()
+	info, err := os.Stat(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != want {
+		t.Fatalf("mode %o, want %o", info.Mode().Perm(), want)
+	}
+}
+
+func TestManagedPairAtomicRenewalAndPermissions(t *testing.T) {
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert.pem"), filepath.Join(dir, "key.pem")
+	a, ak := testPair(t, "node.example.invalid", time.Now().Add(90*24*time.Hour))
+	if err := WriteCertificatePair(cp, kp, a, ak, "node.example.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	assertMode(t, kp, 0600)
+	assertMode(t, cp, 0644)
+	public, _ := os.ReadFile(cp)
+	if bytes.Contains(public, []byte("PRIVATE KEY")) {
+		t.Fatal("public mirror contains a key")
+	}
+	b, bk := testPair(t, "node.example.invalid", time.Now().Add(100*24*time.Hour))
+	if err := WriteCertificatePair(cp, kp, b, bk, "node.example.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	got, _, err := ReadCertificatePair(cp, kp)
+	if err != nil || !bytes.Equal(got, b) {
+		t.Fatalf("new pair not active: %v", err)
+	}
+	old, err := ReadPrivateFile(kp + ".previous")
+	if err != nil || !bytes.Equal(certificatePEM(old), a) {
+		t.Fatal("previous pair missing")
+	}
+	assertMode(t, kp+".previous", 0600)
+	// The authority is one private PEM; a missing public mirror cannot break it.
+	if err := os.Remove(cp); err != nil {
+		t.Fatal(err)
+	}
+	if got, _, err = ReadCertificatePair(cp, kp); err != nil || !bytes.Equal(got, b) {
+		t.Fatal("pair did not survive mirror loss")
+	}
+}
+
+func TestLegacyPairMigrationAndPreCommitFailure(t *testing.T) {
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert"), filepath.Join(dir, "key")
+	a, ak := testPair(t, "node.example.invalid", time.Now().Add(90*24*time.Hour))
+	if err := os.WriteFile(cp, a, 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(kp, ak, 0644); err != nil {
+		t.Fatal(err)
+	}
+	b, bk := testPair(t, "node.example.invalid", time.Now().Add(100*24*time.Hour))
+	err := writeCertificatePair(cp, kp, b, bk, "node.example.invalid", func() error { return errors.New("simulated interrupted deployment") })
+	if err == nil {
+		t.Fatal("expected failure")
+	}
+	got, _, err := ReadCertificatePair(cp, kp)
+	if err != nil || !bytes.Equal(got, a) {
+		t.Fatal("old pair lost after failure")
+	}
+	assertMode(t, kp, 0600)
+	public, _ := os.ReadFile(cp)
+	if !bytes.Equal(public, a) {
+		t.Fatal("public mirror not restored")
+	}
+}
+
+func TestInvalidCandidatesDoNotReplaceOldPair(t *testing.T) {
+	dir := t.TempDir()
+	cp, kp := filepath.Join(dir, "cert"), filepath.Join(dir, "key")
+	a, ak := testPair(t, "node.example.invalid", time.Now().Add(90*24*time.Hour))
+	if err := WriteCertificatePair(cp, kp, a, ak, "node.example.invalid"); err != nil {
+		t.Fatal(err)
+	}
+	b, bk := testPair(t, "other.example.invalid", time.Now().Add(90*24*time.Hour))
